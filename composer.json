{
    "name": "milwad/laravel-validate",
    "description": "The Laravel-Validate package enhances Laravel validation capabilities with custom rules and methods for simplified and efficient validation logic.",
    "keywords": [
        "milwad",
        "laravel",
        "framework",
        "validation",
        "laravel validate package",
        "laravel package",
        "laravel-validation",
        "laravel-validate",
        "validate",
        "regex"
    ],
    "homepage": "https://github.com/milwad-dev/laravel-validate",
    "minimum-stability": "dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Milwad Khosravi",
            "email": "milwad.dev@gmail.com",
            "homepage": "https://github.com/milwad-dev",
            "role": "Author"
        }
    ],
    "require": {
        "php": "^8.2",
        "doctrine/inflector": "^2.0",
        "laravel/framework": "11.*|12.*|^13.0",
        "ext-bcmath": "*",
        "ext-ctype": "*"
    },
    "require-dev": {
        "cijic/phpmorphy": "^0.3.6",
        "imanghafoori/php-imports-analyzer": "1.0.*",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.5.12"
    },
    "suggest": {
        "cijic/phpmorphy": "Required to validate German words with the ValidSingular and ValidPlural rules (^0.3.6)."
    },
    "autoload": {
        "psr-4": {
            "Milwad\\LaravelValidate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Milwad\\LaravelValidate\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Milwad\\LaravelValidate\\LaravelValidateServiceProvider"
            ]
        }
    }
}
